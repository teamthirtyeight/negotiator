# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
.turbo

# Backfill exports contain the activity log (names, deal details)
backfill-export-*.json

# Embedded Postgres data for local development
.pglite/

# Haggle reels: rendered outreach videos (apps/web/scripts/haggle-reels.mts)
reels/

# Local-dev uploads (deployments use Vercel Blob)
apps/web/public/uploads/

# Built by packages/widget
apps/web/public/widget/

# Load-test seed (contains session tokens)
load/k6/.seed.json

# Playwright
apps/e2e/test-results/
apps/e2e/playwright-report/
packages/widget/test-results/
packages/widget/playwright-report/

# Maestro device-flow reports
apps/mobile/.maestro/report-*.xml
