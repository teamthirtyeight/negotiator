{
  "name": "@ghostcart/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ghostcart/widget run build && next dev",
    "build": "pnpm --filter @ghostcart/widget run build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:backfill": "tsx --env-file-if-exists=.env.local scripts/backfill-postgres.mts",
    "db:seed-load": "tsx --env-file-if-exists=.env.local scripts/seed-load-test.mts",
    "db:rotate-secrets": "tsx --env-file-if-exists=.env.local scripts/rotate-secrets.mts",
    "db:ledger-gate": "tsx --env-file-if-exists=.env.local scripts/ledger-gate.mts",
    "launch:check": "tsx scripts/launch-check.mts",
    "test:woo": "WOO_E2E_URL=${WOO_E2E_URL:-http://localhost:8080} vitest run src/lib/woocommerce/woocommerce.docker.test.ts",
    "db:seed-mobile": "tsx scripts/seed-mobile-e2e.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@electric-sql/pglite": "0.5.15",
    "@ghostcart/agent": "workspace:*",
    "@ghostcart/channels": "workspace:*",
    "@ghostcart/core": "workspace:*",
    "@ghostcart/db": "workspace:*",
    "@ghostcart/payments": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.301.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sentry/nextjs": "11.11.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "2.8.2",
    "@vercel/otel": "2.3.0",
    "ai": "^7.0.163",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "mcp-handler": "2.3.1",
    "next": "16.4.5",
    "posthog-node": "5.63.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ghostcart/sdk": "workspace:*",
    "@ghostcart/widget": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
